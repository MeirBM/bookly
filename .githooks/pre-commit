#!/usr/bin/env bash
# Bookly pre-commit gate. A file advises; a hook enforces.
# Install once:  git config core.hooksPath .githooks
set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# --- 1. Secrets -------------------------------------------------------------
# History is permanent and sits in every clone. A committed key is a compromised key.
# Checked in every file. A quoted literal after the delimiter is a value someone
# typed, not an expression, which is what keeps this from matching ordinary code.
patterns=(
  'BEGIN [A-Z ]*PRIVATE KEY'
  'sk-[A-Za-z0-9]{20,}'
  'AKIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{36}'
  'eyJhbGciOi[A-Za-z0-9_-]{20,}'
  '(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}'
  'postgres(ql)?://[^[:space:]"]*:[^[:space:]"@]+@'
)

# Checked only in configuration files, where `key: value` is an assignment rather than
# an expression. YAML and .properties conventionally omit quotes, so requiring one let
# `password: Pr0dP0stgres2026` through untouched. Applying this everywhere was tried and
# reverted: without the quote it matches ordinary code such as `String accessToken = ...`,
# and a hook that cries wolf is a hook people learn to bypass.
config_patterns=(
  '(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*[^"'"'"'[:space:]$][^[:space:]]{7,}'
)
for file in $staged; do
  case "$file" in
    *.example|*.md|.githooks/pre-commit) continue ;;
  esac
  [ -f "$file" ] || continue

  file_patterns=("${patterns[@]}")
  case "$file" in
    *.yml|*.yaml|*.properties|*.env|*.conf|*.ini|*.toml)
      file_patterns+=("${config_patterns[@]}") ;;
  esac

  for p in "${file_patterns[@]}"; do
    # A line carrying the marker below is exempt. The exemption is deliberate and
    # visible: a gate that blocks legitimate work teaches people to pass
    # --no-verify, and a gate routinely bypassed protects nothing. Requiring the
    # marker keeps each exemption written down beside the value and surfaced in
    # review, instead of argued once in a terminal nobody kept.
    # ${VAR} and ${VAR:default} are the environment-placeholder form, which is the pattern
    # people should be using — flagging it would train them to ignore the hook.
    hits=$(git show ":$file" | grep -nEi "$p" | grep -v 'allow-secret' | grep -v '\${' || true)
    if [ -n "$hits" ]; then
      echo "BLOCKED  possible secret in $file  (pattern: $p)"
      echo "$hits" | head -3 | sed 's/^/         /'
      echo "         if this is a test fixture, append:  // allow-secret"
      fail=1
    fi
  done
done

# --- 2. Committed migrations are immutable ----------------------------------
# Never edit a migration that has been committed — add the next one.
for file in $(git diff --cached --name-only --diff-filter=M | grep 'db/migration/.*\.sql$' || true); do
  echo "BLOCKED  $file is an already-committed migration; add a new V{n}__ file instead"
  fail=1
done

# --- 3. Fast unit tests -----------------------------------------------------
# Testcontainers suites run in CI, not here — the hook must stay fast enough to survive.
if echo "$staged" | grep -q '^backend/.*\.java$'; then
  if [ -x backend/mvnw ]; then
    echo "running backend unit tests..."
    if ! (cd backend && ./mvnw -q -o test -DskipITs 2>&1 | tail -25); then
      echo "BLOCKED  backend unit tests failed"
      fail=1
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit refused. Fix the above; do not bypass with --no-verify."
  exit 1
fi
exit 0
