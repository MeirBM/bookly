# Copy to .env and fill in. .env is gitignored and the pre-commit hook scans for
# credentials; a key that reaches history is compromised and must be rotated.

# Signing key for access and refresh tokens. Generate a fresh one:
#   openssl rand -base64 48
JWT_SECRET=

# Database. DATABASE_URL is either a JDBC url (with DATABASE_USER / DATABASE_PASSWORD below) or a
# provider-style postgres://user:password@host/db url (Neon, Render), in which case the user and
# password come from the url and TLS is required for non-local hosts.
# No defaults in application.yml: a deployment that forgets these should
# fail at startup rather than quietly connect to whatever answers on localhost.
DATABASE_URL=jdbc:postgresql://localhost:5432/bookly
DATABASE_USER=bookly
DATABASE_PASSWORD=bookly

# Publish /v3/api-docs and Swagger UI. True for local development; leave false in a
# deployment, where the document is a complete map of the API surface for anyone asking.
EXPOSE_API_DOCS=true

# Redis. REDIS_URL (redis:// or rediss://) wins when set; otherwise host and port are used.
# Rate limiting only: losing it resets counters and nothing else.
REDIS_URL=
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Deployment only: the exact origin of the frontend (scheme + host, no trailing slash), and
# `framework` when behind a proxy that sets X-Forwarded-For (Render does).
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# FORWARD_HEADERS_STRATEGY=framework
