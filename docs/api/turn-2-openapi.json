                        "type": "string",
                        "maxLength": 120,
                        "minLength": 0
                    }
                }
            },
            "CreateWorkingHours": {
                "type": "object",
                "properties": {
                    "weekday": {
                        "type": "string",
                        "enum": [
                            "MONDAY",
                            "TUESDAY",
                            "WEDNESDAY",
                            "THURSDAY",
                            "FRIDAY",
                            "SATURDAY",
                            "SUNDAY"
                        ]
                    },
                    "startsAt": {
                        "type": "string",
                        "example": "14:30:00"
                    },
                    "endsAt": {
                        "type": "string",
                        "example": "14:30:00"
                    }
                },
                "required": [
                    "endsAt",
                    "startsAt",
                    "weekday"
                ]
            },
            "WorkingHoursResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "weekday": {
                        "type": "string",
                        "enum": [
                            "MONDAY",
                            "TUESDAY",
                            "WEDNESDAY",
                            "THURSDAY",
                            "FRIDAY",
                            "SATURDAY",
                            "SUNDAY"
                        ]
                    },
                    "startsAt": {
                        "type": "string",
                        "example": "14:30:00"
                    },
                    "endsAt": {
                        "type": "string",
                        "example": "14:30:00"
                    }
                }
            },
